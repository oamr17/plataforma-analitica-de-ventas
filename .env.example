# Plantilla documental: no se carga automáticamente.
# Las rutas relativas se resuelven desde el directorio de trabajo.
SALES_DATA_DIR=Data
# Contrato local de E1; no se utiliza para abrir conexiones de E2.
SALES_DATABASE_URL=postgresql://localhost:5432/sales_analytics

# E2: ejemplos sin contraseñas. Usar las credenciales privadas de .local.
SALES_WRITER_DATABASE_URL=postgresql://sales_etl@127.0.0.1:55432/sales_analytics
SALES_READER_DATABASE_URL=postgresql://sales_reader@127.0.0.1:55432/sales_analytics
# Las pruebas nunca usan las variables anteriores como alternativa.
SALES_TEST_WRITER_DATABASE_URL=postgresql://sales_e6_etl@127.0.0.1:55432/sales_analytics_e6_test
SALES_TEST_READER_DATABASE_URL=postgresql://sales_e6_reader@127.0.0.1:55432/sales_analytics_e6_test
